# DataHut-DuckHouse — environment template
#
# Copy this to the repo root as `.env` (that is where docker compose and
# python-dotenv both look):
#
#     cp .devcontainer/.env.example .env      # or: make env
#
# `.env` is git-ignored. NEVER commit real credentials — this file only holds
# local-dev placeholders. Dockerfiles and docker-compose.yml contain no secrets;
# every credential is read from here at runtime.

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — change these for anything that is not throwaway local dev
# ─────────────────────────────────────────────────────────────────────────────

# MinIO root account (created on first boot of the minio container).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# S3 credentials the app uses to reach MinIO / S3. For local MinIO these match
# the root account above; against real S3 use a scoped IAM key.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me-minio
AWS_DEFAULT_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# Object store / S3 endpoint
#   docker network : http://minio:9000
#   host / local   : http://localhost:9000
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000

# ─────────────────────────────────────────────────────────────────────────────
# Iceberg
# ─────────────────────────────────────────────────────────────────────────────
# An s3:// URI => HybridBackend wires the object store from the S3 settings above.
# For a purely local warehouse, blank this and set ICEBERG_WAREHOUSE_PATH instead.
ICEBERG_WAREHOUSE=s3://duckhouse-warehouse/
# ICEBERG_WAREHOUSE_PATH=/app/data/iceberg_warehouse
ICEBERG_NAMESPACE=default
ICEBERG_CATALOG=minio_catalog
# SQL catalog location. Unset => local SQLite (single writer). Point at a shared
# DB (postgresql://…) for concurrent writers, until Nessie (ADR-0002 / Phase 3).
# ICEBERG_CATALOG_URI=

# Set to 0 to disable best-effort per-write DuckDB cache snapshots.
# HYBRID_DUCKDB_SNAPSHOTS=1

# ─────────────────────────────────────────────────────────────────────────────
# Arrow Flight server
# ─────────────────────────────────────────────────────────────────────────────
FLIGHT_SERVER_HOST=0.0.0.0
FLIGHT_SERVER_PORT=8815
FLIGHT_TABLE_NAME=data_table
FLIGHT_BATCH_SIZE=10000

# ─────────────────────────────────────────────────────────────────────────────
# DuckDB
# ─────────────────────────────────────────────────────────────────────────────
DUCKDB_PATH=/app/ingestion/data/duckhouse.duckdb
DUCKDB_MEMORY_LIMIT=2GB

# ─────────────────────────────────────────────────────────────────────────────
# Trino   (docker network host: trino / local: localhost)
# ─────────────────────────────────────────────────────────────────────────────
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_USER=datahut
TRINO_CATALOG=iceberg
TRINO_SCHEMA=default

# ─────────────────────────────────────────────────────────────────────────────
# dbt
# ─────────────────────────────────────────────────────────────────────────────
DBT_PROFILES_DIR=transform/dbt_project/config
DBT_PROJECT_DIR=transform/dbt_project

# ─────────────────────────────────────────────────────────────────────────────
# XORQ orchestration service
# ─────────────────────────────────────────────────────────────────────────────
XORQ_STORAGE=xorq/metadata.db
REACT_APP_XORQ_API_URL=http://xorq-service:9980

# ─────────────────────────────────────────────────────────────────────────────
# Observability / app
# ─────────────────────────────────────────────────────────────────────────────
JAEGER_ENDPOINT=
LOG_LEVEL=INFO
ENABLE_MONITORING=true
ENABLE_TRACING=false
ENVIRONMENT=development
DEBUG=true
ENABLE_AUTH=false

# ─────────────────────────────────────────────────────────────────────────────
# CSV ingestion helper scripts
# ─────────────────────────────────────────────────────────────────────────────
CSV_PATH=ingestion/data/data.csv
